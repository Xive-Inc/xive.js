{
  "name": "xive.js",
  "version": "0.4.1",
  "description": "Build bots for Xive hubs.",
  "keywords": [
    "xive",
    "bot",
    "api",
    "gateway",
    "slash-commands",
    "discord.js"
  ],
  "homepage": "https://github.com/Xive-Inc/xive.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xive-Inc/xive.js.git"
  },
  "bugs": {
    "url": "https://github.com/Xive-Inc/xive.js/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "types/index.d.ts",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "centrifuge": "^5.7.0"
  },
  "scripts": {
    "test": "node --test src/*.test.js",
    "test:types": "npx -y -p typescript@5 -p @types/node@22 -c 'tsc -p test-d --typeRoots \"$(dirname \"$(command -v tsc)\")/../@types\"'"
  },
  "license": "Apache-2.0"
}
